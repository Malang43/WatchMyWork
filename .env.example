# Backend only. Keep your existing .env; do not overwrite it with this template.
# Set your OpenRouter key locally. Never use a VITE_ prefix for a secret.
OPENROUTER_API_KEY=
# Optional backend-only search fallback. Local loopback sites are not web-searchable.
TAVILY_API_KEY=
# Optional: override the SQLite data directory for isolated test environments.
# WATCHMYWORK_DATA_DIR=C:/path/to/local/data
# Existing Railway settings (keep your deployed values):
# DATABASE_PATH=/data/watchmywork.sqlite3
# BOB_DEBUG_DIR=/data/bob_debug_package
# PUBLIC_ORIGIN=https://your-domain.example
# WATCHMYWORK_PRODUCTION=1
# PORT and RAILWAY_PUBLIC_DOMAIN are supplied by Railway.
